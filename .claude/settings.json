{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(*)",
      "Write(*)",
      "Read(*)",
      "Bash(npm *)",
      "Bash(npx *)"
    ],
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(rtk git commit*)",
      "Bash(rtk git push*)"
    ]
  },
  "extraKnownMarketplaces": {
    "atelier": {
      "source": {
        "source": "github",
        "repo": "PetitPelican/claude-harnais"
      }
    }
  },
  "enabledPlugins": {
    "harnais@atelier": true
  }
}
